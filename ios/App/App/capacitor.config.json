{
	"appId": "com.yogistudio.app",
	"appName": "YogiStudio",
	"webDir": "dist",
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"FirebaseAuthentication": {
			"providers": [
				"phone"
			]
		},
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK"
		}
	},
	"packageClassList": [
		"MediaPlugin",
		"FirebaseAuthenticationPlugin",
		"AppPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
